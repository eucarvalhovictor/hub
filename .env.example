# Supabase — copie para .env.local e preencha
# Dashboard: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxxxxxxxxx

# Server-side only (cria um service key em Settings → API → "service_role")
# Usado apenas em Server Actions/Rotas para operações administrativas.
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxxxxxx

# App
NEXT_PUBLIC_APP_NAME=Hub
NEXT_PUBLIC_APP_URL=http://localhost:3000
